# ===============================================
# VPS & PROXY CONFIGURATION (.env)
# ===============================================

# --- VPS SSH Credentials ---
VPS_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASS=

# --- Proxy Credentials & Ports ---
# If left blank, random secure username/password will be generated automatically
PROXY_USER=
PROXY_PASS=

# Ports
HTTP_PORT=8443
SOCKS5_PORT=1080

# Enable HTTPS TLS for HTTP Proxy (true / false)
ENABLE_HTTPS=false
